  oilCapacity     Float? // Liters
  coolantType     String? // 'WATER', 'GLYCOL', 'AIR'

  // Linked to FL
  flId String?

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engineType])
