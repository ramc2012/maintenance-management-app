// ============================================================================
// FL ASSET ASSIGNMENT (Link Equipment/Instruments to Functional Locations)
// ============================================================================
// Supports: VFD → Motor → Pump trains, instrument mapping, driver/driven relationships

model FLAssetAssignment {
  id String @id @default(uuid())

  // Functional Location link
  flId String
  fl   FunctionalLocation @relation("FLAssets", fields: [flId], references: [id], onDelete: Cascade)

