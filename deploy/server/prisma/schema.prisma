generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Discipline {
  MECHANICAL
  ELECTRICAL
  INSTRUMENTATION
}

enum UserPersona {
  MANAGER
  FIELD
  HYBRID
}

enum DisciplineAccessLevel {
  VIEW
  EXECUTE
  MANAGE
}

model User {
  id                       String                  @id @default(uuid())
  username                 String                  @unique
  password                 String
  role                     String
  isExternal               Boolean                 @default(false)
  companyName              String?
  phone                    String?
  jobTitle                 String?
  departmentId             String?
  department               Department?             @relation(fields: [departmentId], references: [id])
  managerId                String?
  manager                  User?                   @relation("UserReportingLine", fields: [managerId], references: [id])
  directReports            User[]                  @relation("UserReportingLine")
  createdAt                DateTime                @default(now())
  lastLogin                DateTime?
  canCreateWorkOrder       Boolean                 @default(false)
  canCloseWorkOrder        Boolean                 @default(false)
  comments                 CaseComment[]
  contractAccesses         ContractUserAccess[]
  contractorRequests       MaintenanceRequest[]    @relation("ContractorRequestsCreated")
  contractorWorkOrders     WorkOrder[]             @relation("ContractorWorkOrdersCreated")
  contractReportsSubmitted ContractorReport[]      @relation("ContractReportsSubmitted")
  contractReportsReviewed  ContractorReport[]      @relation("ContractReportsReviewed")
  disciplineAccesses       UserDisciplineAccess[]
  workOrderExecutionEvents WorkOrderExecutionLog[] @relation("WorkOrderExecutionPerformedBy")
  workOrderAssignments     WorkOrderTeam[]         @relation("WorkOrderTeamUser")
  repositoryDocuments      RepositoryDocument[]

  @@index([departmentId])
  @@index([managerId])
}

model Company {
  id          String       @id @default(uuid())
  name        String       @unique
  departments Department[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
  budgets   Budget[]
  cases     Case[]
}

model UserDisciplineAccess {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline           Discipline
  accessLevel          DisciplineAccessLevel @default(EXECUTE)
  isDefault            Boolean               @default(false)
  canViewProcurement   Boolean               @default(true)
  canUpdateProcurement Boolean               @default(false)
  canRaiseRequirements Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([userId, discipline])
  @@index([userId, isDefault])
  @@index([discipline, accessLevel])
}

model Budget {
  id           String      @id @default(uuid())
  departmentId String?
  fy           String
  category     String
  amount       Float
  isIndicative Boolean     @default(false)
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([departmentId, fy, category])
}

model CaseComment {
  id            String    @id @default(uuid())
  content       String
  timestamp     DateTime  @default(now())
  effectiveDate DateTime?
  caseId        String
  userId        String
  stageSnapshot String?
  case          Case      @relation(fields: [caseId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
}

model Case {
  id                  String        @id @default(uuid())
  title               String
  type                String
  currentStage        String
  updatedAt           DateTime      @updatedAt
  createdAt           DateTime      @default(now())
  createdBy           String
  vendor              String?
  vendorCode          String?
  prValue             Float?
  poValue             Float?
  currency            String        @default("INR")
  prNumber            String?
  poNumber            String?
  sanctionFileNumber  String?
  tenderingFileNumber String?
  procurementMethod   String?
  category            String?
  value               Float?
  tag                 String?
  processedBy         String?
  departmentId        String?
  department          Department?   @relation(fields: [departmentId], references: [id])
  primaryDiscipline   Discipline    @default(MECHANICAL)
  comments            CaseComment[]
  equipmentTag        String? // link spend to specific equipment
  maintenanceRelated  Boolean       @default(false) // flag for maintenance cost reports

  @@index([primaryDiscipline, currentStage])
}

// --- EQUIPMENT & CALIBRATION MODULE ---

model Installation {
  id             String  @id @default(uuid())
  installationId String  @unique
  location       String
  type           String // Surface, Drilling Rig, Workover Rig, Mobile Units
  isActive       Boolean @default(true)

  instruments       InstrumentMaster[]
  runningEquipment  RunningEquipmentMaster[]
  maintenanceLogs   MaintenanceLog[]
  trainings         TrainingRecord[]            @relation("InstallationTrainings")
  energyLogs        DailyEnergyLog[]            @relation("InstallationEnergyLogs")
  electricBills     MonthlyElectricityBill[]    @relation("InstallationElectricBills")
  contractScopes    ContractInstallationScope[]
  contractorReports ContractorReport[]
  operationalLogs   OperationalLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstrumentMaster {
  tagId       String  @id
  type        String
  serviceLine String? // PT, TT, FT
  description String
  make        String?
  model       String?
  serialNo    String?
  rangeMin    Float?
  rangeMax    Float?
  unit        String?
  modelYear   Int?

  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  primaryDiscipline Discipline @default(INSTRUMENTATION)

  calibrationFreqMonths Int @default(12)

  // Tiered Calibration Routing: INTERNAL (manual) or AUTOMATED (external system)
  calSystemType String @default("INTERNAL") // INTERNAL, AUTOMATED

  calibrationLogs    CalibrationLog[]
  replacementHistory ReplacementHistory[]
  custodyMeterId     String?
  custodyMeter       CustodyTransferMeter? @relation(fields: [custodyMeterId], references: [id])
  internalMeterId    String?
  internalMeter      InternalFlowMeter?    @relation(fields: [internalMeterId], references: [id])

  purchaseDate         DateTime?
  commissioningDate    DateTime?
  warrantyExpiry       DateTime?
  criticality          String? // A, B, C
  safetyClassification String? // SIS, PROCESS, UTILITY
  processConnection    String? // 1/2" NPT, Flanged, etc.
  mountingLocation     String?
  drawingRef           String? // P&ID reference
  healthStatus         String    @default("OK") // OK, WARNING, CRITICAL

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  CalibrationEvent          CalibrationEvent[]
  contractorReports         ContractorReport[]
  UnifiedCalibrationHistory UnifiedCalibrationHistory[]

  @@index([primaryDiscipline, installationId])
}

model EquipmentType {
  id          String  @id @default(uuid())
  name        String  @unique
  category    String // STATIC, RUNNING
  make        String?
  model       String?
  description String?

  pmSchedules PMSchedule[]
  equipment   RunningEquipmentMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RunningEquipmentMaster {
  equipmentTag    String  @id
  category        String // STATIC, RUNNING
  description     String
  make            String?
  model           String?
  powerRating     String?
  pmFrequencyDays Int? // PM frequency in days

  // JSONB for flexible specifications
  specifications    Json? // Voltage, RPM, Range, etc.
  equipmentTypeName String?
  serviceLine       String? // PT, TT, Motor, Pump, etc.

  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  primaryDiscipline Discipline @default(MECHANICAL)

  equipmentTypeId String?
  equipmentType   EquipmentType? @relation(fields: [equipmentTypeId], references: [id])

  commissioningDate DateTime?
  warrantyExpiry    DateTime?
  criticality       String? // A, B, C
  ratedPressure     Float?
  ratedTemperature  Float?
  ratedFlow         Float?
  purchaseDate      DateTime?
  mountingLocation  String?
  drawingRef        String? // P&ID reference
  purchaseOrderNo   String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contractorReports ContractorReport[]
  logs              EquipmentLog[]
  operationalLogs   OperationalLog[]
  pmsInitialStates  PMSInitialState[]

  @@index([primaryDiscipline, installationId])
}

model CalibrationStandard {
  tagId       String    @id
  description String
  make        String?
  model       String?
  category    String // Lab, Field
  modelYear   Int?
  lastCalDate DateTime?
  dueDate     DateTime?
  reportUrl   String?
  parameters  Json? // Parameters this standard can calibrate
  isActive    Boolean   @default(true)

  calibrationLogs CalibrationLog[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  CalibrationEvent        CalibrationEvent[]
  CalibrationTraceability CalibrationTraceability[]
}

model CalibrationLog {
  id String @id @default(uuid())

  instrumentTagId String
  instrument      InstrumentMaster @relation(fields: [instrumentTagId], references: [tagId])

  masterStdId    String
  masterStandard CalibrationStandard @relation(fields: [masterStdId], references: [tagId])

  lastCalDate    DateTime
  currentCalDate DateTime
  nextDueDate    DateTime
  result         String // PASS, FAIL
  performedBy    String
  reportFileUrl  String?

  fivePointData Json

  createdAt DateTime @default(now())
}

model ReplacementHistory {
  id String @id @default(uuid())

  instrumentTagId String
  instrument      InstrumentMaster @relation(fields: [instrumentTagId], references: [tagId])

  oldSerialNo String?
  newSerialNo String
  replacedBy  String
  date        DateTime @default(now())
  reason      String?
}

model InstrumentType {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  pmSchedules PMSchedule[]
  createdAt   DateTime     @default(now())
}

model MeterType {
  id           String   @id @default(uuid())
  name         String   @unique // Orifice, Turbine, Ultrasonic, Coriolis
  configSchema Json // Dynamic fields configuration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustodyTransferMeter {
  id           String  @id @default(uuid())
  meterId      String  @unique
  customerId   String
  customerName String
  meterType    String? // Reference to MeterType.name
  product      String?
  fluidType    String  @default("LIQUID")

  pipeSize    String?
  elementSize String?
  configData  Json? // Dynamic config based on MeterType
  details     String?

  instruments InstrumentMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PMSchedule {
  id              String @id @default(uuid())
  frequency       String
  taskDescription String

  instrumentTypeId String?
  instrumentType   InstrumentType? @relation(fields: [instrumentTypeId], references: [id], onDelete: Cascade)

  equipmentTypeId String?
  equipmentType   EquipmentType? @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  alertLeadTime   Float             @default(50)
  initialStates   PMSInitialState[]
  maintenanceLogs MaintenanceLog[]
}

model InternalFlowMeter {
  id          String  @id @default(uuid())
  meterId     String  @unique
  description String
  location    String?
  meterType   String? // Reference to MeterType.name
  fluidType   String  @default("LIQUID")
  product     String?

  pipeSize    String?
  elementSize String?
  configData  Json? // Dynamic config based on MeterType

  instruments InstrumentMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MASTER DATA TABLES ---

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalibrationPerformer {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  name           String
  employmentType String // Regular, Contractual
  company        String   @default("ONGC")
  designation    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- MAINTENANCE & REPORTS MODULE ---

model Manpower {
  id              String               @id @default(uuid())
  employeeId      String               @unique
  name            String
  department      String // DS, Electrical, Mechanical
  section         String? // Instrumentation, Power, Drilling
  designation     String?
  isActive        Boolean              @default(true)
  maintenanceLogs MaintenanceLogTeam[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model MaintenanceLog {
  id             String       @id @default(uuid())
  date           DateTime
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])
  primaryDiscipline Discipline @default(MECHANICAL)
  department     String // DS, Electrical, Mechanical
  section        String // Instrumentation, Power, Drilling

  // Job Classification
  jobType           String // PM, BD
  reportCriticality Int // 1=Routine, 2=Significant(Monthly), 3=Critical(Annual)

  // Job Details
  equipmentTag      String? // Reference to equipment
  equipmentTypeName String?
  serviceLine       String? // INSTRUMENT or RUNNING_EQUIPMENT
  notificationNo    String?
  description       String

  // Status & Time
  status        String // Open, In Progress, Closed
  startTime     DateTime
  endTime       DateTime
  durationHours Float
  remarks       String?
  assignedBy    String?  @default("System")
  assignedAt    DateTime @default(now())

  // BD-specific time fields (only used when jobType = BD)
  bdReportTime      DateTime?
  teamReportTime    DateTime?
  jobCompletionTime DateTime?

  // Team Assignment (many-to-many)
  teamMembers MaintenanceLogTeam[]
  externalCrew Json?

  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pmsScheduleId String? // Link to specific PMS task
  pmsSchedule   PMSchedule? @relation(fields: [pmsScheduleId], references: [id])

  @@index([primaryDiscipline, date])
  @@index([primaryDiscipline, installationId])
}

model MaintenanceLogTeam {
  id               String         @id @default(uuid())
  maintenanceLogId String
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  manpowerId       String
  manpower         Manpower       @relation(fields: [manpowerId], references: [id])

  @@unique([maintenanceLogId, manpowerId])
}

// Note: BD-specific time fields added to MaintenanceLog
// bdReportTime, teamReportTime, jobCompletionTime are used when jobType = 'BD'

model EquipmentLog {
  id    String   @id @default(uuid())
  date  DateTime
  shift String

  equipmentTag String
  equipment    RunningEquipmentMaster @relation(fields: [equipmentTag], references: [equipmentTag])

  runStatus              Boolean
  startTime              DateTime?
  stopTime               DateTime?
  totalRunHours          Float?
  cumulativeMeterReading Float?

  parameters Json?
  remarks    String?
  assignedBy String?  @default("System")
  assignedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperationalMetricDefinition {
  id              String   @id @default(uuid())
  code            String   @unique
  label           String
  unit            String?
  assetClass      String?
  valueType       String // NUMBER, BOOLEAN, TEXT, ENUM
  captureType     String  @default("MANUAL") // MANUAL, AUTO, EITHER
  aggregationRule String?
  alertMin        Float?
  alertMax        Float?
  warningMin      Float?
  warningMax      Float?
  displayGroup    String?
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profileMetrics AssetLogProfileMetric[]
  logMetrics     OperationalLogMetric[]
}

model AssetLogProfile {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  assetClass        String   @default("RUNNING_EQUIPMENT")
  description       String?
  logGranularity    String   @default("DAILY")
  defaultSourceMode String   @default("MANUAL")
  requiresApproval  Boolean  @default(false)
  allowBackdated    Boolean  @default(true)
  active            Boolean  @default(true)
  matcherKeywords   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  metrics AssetLogProfileMetric[]
}

model AssetLogProfileMetric {
  id                 String   @id @default(uuid())
  assetLogProfileId  String
  assetLogProfile    AssetLogProfile           @relation(fields: [assetLogProfileId], references: [id], onDelete: Cascade)
  metricDefinitionId String
  metricDefinition   OperationalMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)
  isRequired         Boolean  @default(false)
  sequence           Int      @default(0)
  defaultVisible     Boolean  @default(true)

  @@unique([assetLogProfileId, metricDefinitionId])
}

model OperationalLog {
  id                 String   @id @default(uuid())
  logDate            DateTime
  shift              String   @default("GENERAL") // GENERAL, DAY, NIGHT
  granularity        String   @default("DAILY") // DAILY, SHIFT, HOURLY_SUMMARY
  sourceMode         String   @default("MANUAL") // MANUAL, AUTO, HYBRID
  sourceStatus       String   @default("DRAFT") // DRAFT, AUTO_CAPTURED, REVIEWED, APPROVED, REJECTED
  assetClass         String   @default("RUNNING_EQUIPMENT")
  profileCode        String?
  installationId     String
  installation       Installation          @relation(fields: [installationId], references: [id])
  primaryDiscipline  Discipline            @default(MECHANICAL)
  equipmentTag       String
  equipment          RunningEquipmentMaster @relation(fields: [equipmentTag], references: [equipmentTag])
  runtimeHours       Float?
  downtimeHours      Float?
  standbyHours       Float?
  cumulativeHours    Float?
  operatingState     String? // RUNNING, STOPPED, STANDBY, TRIPPED, MAINTENANCE
  availabilityStatus String? // AVAILABLE, DEGRADED, UNAVAILABLE
  enteredBy          String?
  reviewedBy         String?
  approvedBy         String?
  approvedAt         DateTime?
  remarks            String?
  qualityScore       Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  metrics             OperationalLogMetric[]
  compressorProcessLog GasCompressionLog?

  @@unique([logDate, shift, equipmentTag])
  @@index([installationId, logDate])
  @@index([equipmentTag, logDate])
  @@index([sourceMode, logDate])
  @@index([primaryDiscipline, logDate])
}

model OperationalLogMetric {
  id                 String   @id @default(uuid())
  operationalLogId   String
  operationalLog     OperationalLog            @relation(fields: [operationalLogId], references: [id], onDelete: Cascade)
  metricDefinitionId String
  metricDefinition   OperationalMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)
  valueNumber        Float?
  valueText          String?
  valueBoolean       Boolean?
  valueEnum          String?
  sourceQuality      String?
  sourceTag          String?
  readingTimestamp   DateTime?
  createdAt          DateTime @default(now())

  @@unique([operationalLogId, metricDefinitionId])
}

model PMSInitialState {
  id String @id @default(uuid())

  equipmentTag String
  equipment    RunningEquipmentMaster @relation(fields: [equipmentTag], references: [equipmentTag])

  pmsScheduleId String
  pmsSchedule   PMSchedule @relation(fields: [pmsScheduleId], references: [id])

  initialLastDoneHours Float // The meter reading when it was last done before system start

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipmentTag, pmsScheduleId])
}

// ============================================================================
// ISO 14224 ASSET HIERARCHY SYSTEM
// ============================================================================

// === HIERARCHY: Site → Area → System → Functional Location ===

model Site {
  id       String  @id @default(uuid())
  siteId   String  @unique // e.g., "VAD-PLANT-A"
  name     String
  location String?
  isActive Boolean @default(true)

  areas Area[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id     String @id @default(uuid())
  areaId String @unique // e.g., "UNIT-1"
  name   String
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  systems System[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model System {
  id        String @id @default(uuid())
  systemTag String @unique // e.g., "FEED-WATER-SYS"
  name      String
  areaId    String
  area      Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  functionalLocations FunctionalLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FunctionalLocation {
  id           String  @id @default(uuid())
  flId         String  @unique // e.g., "P-101-M" (Motor slot)
  name         String
  description  String?
  flType       String // 'SKID', 'POSITION', 'PROTECTION'
  positionType String? // 'DRIVER', 'DRIVEN' for pairing

  // Self-referencing hierarchy (Parent/Child)
  parentFlId String?
  parentFl   FunctionalLocation?  @relation("FL_Hierarchy", fields: [parentFlId], references: [id])
  childFls   FunctionalLocation[] @relation("FL_Hierarchy")

  // Link to System
  systemId String
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  // Current installed asset (denormalized for performance)
  currentAssetId String?
  currentAsset   Asset?  @relation("CurrentInstallation", fields: [currentAssetId], references: [id])

  // Relations
  installations          AssetInstallation[]
  maintenanceAssignments MaintenancePlanAssignment[]
  readings               OperationalReading[]
  workOrders             WorkOrder[]

  // Multi-Driver Skid Configuration relations
  skidConfigurations SkidConfiguration[] @relation("SkidConfig")
  asDriverIn         SkidDriveTrain[]    @relation("DriveTrainDriver")
  asDrivenIn         SkidDriveTrain[]    @relation("DriveTrainDriven")
  assetAssignments   FLAssetAssignment[] @relation("FLAssets")

  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  AssignmentAuditLog AssignmentAuditLog[]
  contractScopes     ContractFunctionalLocationScope[]
}

// === ASSETS (Physical Equipment with JSONB Specs) ===

model Asset {
  id           String  @id @default(uuid())
  assetCode    String  @unique // Internal asset code
  serialNumber String?
  manufacturer String?
  model        String?
  modelYear    Int?

  assetClass String // 'MOTOR', 'PUMP', 'COMPRESSOR', 'INSTRUMENT', etc.
  status     String @default("IN_STORE") // IN_STORE, INSTALLED, REPAIR, SCRAPPED

  // JSONB for flexible specifications
  specifications Json? // Rating, voltage, kW, head, etc.

  // Current location (denormalized for quick lookup)
  currentFlId String?
  currentFl   FunctionalLocation[] @relation("CurrentInstallation")

  // Installation history
  installations AssetInstallation[]

  commissioningDate DateTime?
  warrantyExpiry    DateTime?
  criticality       String? // A, B, C
  purchaseDate      DateTime?
  nextInspectionDue DateTime?
  certifications    Json? // {PESO: true, IBR: false, ATEX: true}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetInstallation {
  id String @id @default(uuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  flId               String
  functionalLocation FunctionalLocation @relation(fields: [flId], references: [id])

  installDate DateTime
  removalDate DateTime? // NULL if currently installed
  installedBy String?
  removedBy   String?
  reason      String? // SCHEDULED_PM, FAILURE, UPGRADE

  meterReadingAtInstall Float?
  meterReadingAtRemoval Float?

  createdAt DateTime @default(now())

  @@index([flId, installDate])
  @@index([assetId, installDate])
}

// === MAINTENANCE STRATEGY LIBRARY ===

model MaintenanceStrategy {
  id          String  @id @default(uuid())
  name        String  @unique // "MV Motor - Annual Service"
  assetClass  String? // Applicable asset class
  description String?
  isActive    Boolean @default(true)

  tasks       StrategyTask[]
  assignments MaintenancePlanAssignment[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  RCMAnalysis RCMAnalysis[]
}

model StrategyTask {
  id         String              @id @default(uuid())
  strategyId String
  strategy   MaintenanceStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  taskCode       String // "CHK-TERM", "MEG-TEST", "GRS-BRG"
  description    String
  sequence       Int     @default(0)
  estimatedHours Float?
  skillRequired  String? // ELECTRICAL, MECHANICAL, INSTRUMENTATION

  createdAt DateTime @default(now())
}

model MaintenancePlanAssignment {
  id String @id @default(uuid())

  flId               String
  functionalLocation FunctionalLocation @relation(fields: [flId], references: [id])

  strategyId String
  strategy   MaintenanceStrategy @relation(fields: [strategyId], references: [id])

  triggerType   String // 'TIME', 'USAGE', 'CONDITION'
  intervalValue Int // e.g., 6 (months) or 2000 (hours)
  intervalUnit  String // 'MONTHS', 'DAYS', 'HOURS', 'KM'

  lastDoneDate    DateTime?
  lastDoneReading Float? // Meter reading when last done
  nextDueDate     DateTime?
  nextDueReading  Float?

  alertLeadDays Int     @default(14) // Alert X days before due
  isActive      Boolean @default(true)

  workOrders WorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flId, strategyId])
}

// === OPERATIONAL DATA ===

model OperationalReading {
  id String @id @default(uuid())

  flId               String
  functionalLocation FunctionalLocation @relation(fields: [flId], references: [id])

  timestamp  DateTime @default(now())
  metricType String // 'RUN_HOURS', 'AMPS', 'VIBRATION', 'TEMP'
  value      Float
  unit       String?

  recordedBy String?
  source     String  @default("MANUAL") // 'MANUAL', 'SCADA', 'IOT'

  @@index([flId, metricType, timestamp])
}

// === WORK ORDERS (Execution & History) ===

model WorkOrder {
  id       String @id @default(uuid())
  woNumber String @unique

  flId               String
  functionalLocation FunctionalLocation @relation(fields: [flId], references: [id])

  assignmentId String?
  assignment   MaintenancePlanAssignment? @relation(fields: [assignmentId], references: [id])

  woType                    String // 'PREVENTIVE', 'CORRECTIVE', 'PREDICTIVE'
  priority                  String    @default("NORMAL") // LOW, NORMAL, HIGH, EMERGENCY
  status                    String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CLOSED
  requestOrigin             String    @default("INTERNAL") // INTERNAL, CONTRACTOR, SYSTEM, CMS_WORKSPACE
  executionStage            String    @default("REQUESTED") // REQUESTED, ASSIGNED, DEPLOYED, WORK_DONE, REPORT_SUBMITTED, VERIFIED, CLOSED
  executionUpdatedAt        DateTime?
  contractId                String?
  primaryDiscipline         Discipline @default(MECHANICAL)
  assignedContractorCompany String?

  description    String
  scheduledDate  DateTime?
  startDate      DateTime?
  completionDate DateTime?

  // ISO 14224 Closing Codes
  failureMode String? // BRD, LKG, STK, SHV, OHT, etc.
  causeCode   String? // LUB, WER, OVL, AGE, etc.
  actionTaken String? // REPLACE, REPAIR, ADJUST, CLEAN

  meterReading Float? // Reading at close (for usage-based triggers)
  labourHours  Float?
  downtime     Float? // Hours of downtime

  remarks         String?
  assignedBy      String?  @default("System")
  assignedAt      DateTime @default(now())
  closedBy        String?
  createdBy       String
  createdByUserId String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // ISO 14224 Relations
  failureModeRel   FailureMode?      @relation("WOFailureMode", fields: [failureMode], references: [code])
  mechanismRel     FailureMechanism? @relation("WOMechanism", fields: [failureMechanism], references: [code])
  causeCodeRel     CauseCode?        @relation("WOCause", fields: [causeCode], references: [code])
  actionCodeRel    ActionCode?       @relation("WOAction", fields: [actionTaken], references: [code])
  failureMechanism String?

  maintenanceRequestId String?
  contract             Contract?               @relation(fields: [contractId], references: [id])
  createdByUser        User?                   @relation("ContractorWorkOrdersCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  teamMembers          WorkOrderTeam[]
  checklist            WorkOrderChecklist[]
  attachments          WOAttachment[]
  executionLogs        WorkOrderExecutionLog[]
  contractorReports    ContractorReport[]

  @@index([flId, status])
  @@index([status, scheduledDate])
  @@index([contractId, executionStage])
  @@index([primaryDiscipline, status])
}

// === ISO 14224 REFERENCE TABLES ===

model FailureMode {
  code        String        @id // 'BRD', 'LKG', 'STK'
  name        String // 'Bearing Damage', 'Leakage', 'Stuck'
  description String?
  category    String? // 'ROTATING', 'STATIC', 'ELECTRICAL', 'INSTRUMENT'
  assetClass  String? // Applicable to specific classes
  createdAt   DateTime      @default(now())
  RCMAnalysis RCMAnalysis[]
  workOrders  WorkOrder[]   @relation("WOFailureMode")
}

model FailureMechanism {
  code        String      @id // 'WEA', 'FAT', 'COR', 'OVS'
  name        String // 'Wear', 'Fatigue', 'Corrosion', 'Overstress'
  description String?
  category    String? // 'MECHANICAL', 'ELECTRICAL', 'PROCESS'
  createdAt   DateTime    @default(now())
  workOrders  WorkOrder[] @relation("WOMechanism")
}

model CauseCode {
  code        String      @id // 'LUB', 'WER', 'OVL'
  name        String // 'Lubrication Failure', 'Wear', 'Overload'
  description String?
  category    String? // 'HUMAN', 'EQUIPMENT', 'EXTERNAL'
  createdAt   DateTime    @default(now())
  workOrders  WorkOrder[] @relation("WOCause")
}

model ActionCode {
  code        String      @id // 'REPLACE', 'REPAIR'
  name        String
  description String?
  category    String? // 'CORRECTIVE', 'PREVENTIVE'
  createdAt   DateTime    @default(now())
  workOrders  WorkOrder[] @relation("WOAction")
}

// ============================================================================
// ISO 10012 CALIBRATION SYSTEM (Enhanced)
// ============================================================================

// CalibrationEvent: The certificate (As Found / As Left)
model CalibrationEvent {
  id            String @id @default(uuid())
  certificateNo String @unique // Auto-generated CAL-2024-0001

  // Links
  instrumentTagId String
  instrument      InstrumentMaster @relation(fields: [instrumentTagId], references: [tagId])

  standardUsedId String
  standardUsed   CalibrationStandard @relation(fields: [standardUsedId], references: [tagId])

  // Dates
  calibrationDate DateTime
  previousCalDate DateTime?
  nextDueDate     DateTime

  // ISO 10012: Environmental Conditions (mandatory)
  ambientTemp         Float? // Celsius
  humidity            Float? // %RH
  atmosphericPressure Float? // mbar

  // Results
  overallResultAsFound String // 'PASS', 'FAIL', 'OUT_OF_TOLERANCE'
  overallResultAsLeft  String // 'PASS', 'FAIL', 'ADJUSTED'

  maxErrorFoundPct Float? // Worst error found
  maxErrorLeftPct  Float? // Worst error after adjustment

  // Workflow
  status         String  @default("COMPLETED") // DRAFT, IN_PROGRESS, COMPLETED, APPROVED
  adjustmentMade Boolean @default(false)
  repairRequired Boolean @default(false)

  // Sign-off
  performedBy  String
  approvedBy   String?
  approvalDate DateTime?

  remarks       String?
  assignedBy    String?  @default("System")
  assignedAt    DateTime @default(now())
  reportFileUrl String?

  // Calibration Points (5-point or multi-point)
  points CalibrationPoint[]

  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  UnifiedCalibrationHistory UnifiedCalibrationHistory[]

  @@index([instrumentTagId, calibrationDate])
}

// CalibrationPoint: The actual readings (As Found / As Left)
model CalibrationPoint {
  id String @id @default(uuid())

  eventId String
  event   CalibrationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sequence    Int // 1, 2, 3, 4, 5
  stepPercent Float // 0, 25, 50, 75, 100
  direction   String @default("UP") // 'UP' or 'DOWN' (for hysteresis check)

  // Input Applied (from standard)
  inputApplied Float // The known value applied
  inputUnit    String? // 'Bar', 'PSI', etc.

  // Expected Reading (calculated from instrument range)
  expectedReading Float // What the instrument SHOULD show
  expectedUnit    String? // 'mA', 'Bar', etc.

  // AS FOUND (before adjustment)
  asFoundReading Float // Actual reading before touch
  asFoundError   Float? // Calculated: |asFound - expected| / span * 100
  asFoundResult  String? // 'PASS', 'FAIL' (auto-calculated)

  // AS LEFT (after adjustment)
  asLeftReading Float? // Only if adjustment was made
  asLeftError   Float? // Calculated error
  asLeftResult  String? // 'PASS', 'FAIL'

  @@unique([eventId, sequence, direction])
  @@index([eventId])
}

// ============================================================================
// ISO 14224 FULL COMPLIANCE: 9-Level Taxonomy & Failure Coding
// ============================================================================

// ISO 14224 Hierarchy Level Reference
model ISO14224Level {
  id          Int     @id
  name        String // Industry, Business Category, Installation, etc.
  description String?
  example     String? // Petrochemical, Upstream, Vadodara Plant A
}

// Enhanced Cause Code (Root cause - WHY it happened)
// Already exists as CauseCode, keeping for backward compatibility

// ============================================================================
// SAE JA1011 RCM (Reliability Centered Maintenance) Analysis
// ============================================================================

model RCMAnalysis {
  id String @id @default(uuid())

  strategyId String
  strategy   MaintenanceStrategy @relation(fields: [strategyId], references: [id])

  // RCM Question 1: Functions
  assetFunction String // "Pump 500m3/hr @ 40 bar"

  // RCM Question 2: Functional Failures
  functionalFailures String? // "Fails to pump, Low pressure output"

  // RCM Question 3: Failure Modes (links to FailureMode table)
  failureModeCode String?
  failureMode     FailureMode? @relation(fields: [failureModeCode], references: [code])

  // RCM Question 4: Failure Effects
  failureEffects String? // "Production stop, 50K/hr loss"

  // RCM Question 5: Consequences (Criticality)
  consequence String // 'SAFETY', 'ENVIRONMENTAL', 'OPERATIONAL', 'NON_OPERATIONAL'
  criticality String // 'A', 'B', 'C' (High/Medium/Low)

  // RCM Question 6: Task Selection Justification
  taskJustification String? // "Visual check selected because vibration monitoring too expensive"

  // RCM Question 7: Interval Determination
  intervalBasis String? // "P-F Interval = 6 months, Task interval = 3 months"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strategyId])
}

// ============================================================================
// CALIBRATION TRACEABILITY CHAIN (ISO 10012 Enhanced)
// ============================================================================

// Traceability Level for calibration chain
// Level 1: National Standard (NIST/NPL)
// Level 2: Reference Standard (External Lab)
// Level 3: Working Standard (Your Fluke)
// Level 4: Process Instrument

model CalibrationTraceability {
  id String @id @default(uuid())

  standardId String
  standard   CalibrationStandard @relation(fields: [standardId], references: [tagId])

  traceabilityLevel Int // 1, 2, 3, or 4

  // Parent in the traceability chain
  parentStandardId String?

  // Certificate from higher level
  externalCertificateNo String?
  externalLabName       String?

  createdAt DateTime @default(now())
}

// ============================================================================
// TIERED CALIBRATION SYSTEM (Hybrid Integration)
// ============================================================================
// Tier 1: AUTOMATED - Custody Transfer, Safety (SIS), Environmental (fiscal metering)
// Tier 2: INTERNAL - Process Control, Utility Meters, Local Gauges

// Unified Calibration History View
// Merges both AUTOMATED external and INTERNAL calibration results
model UnifiedCalibrationHistory {
  id String @id @default(uuid())

  instrumentTagId String
  instrument      InstrumentMaster @relation(fields: [instrumentTagId], references: [tagId])

  calDate      DateTime
  resultStatus String // 'PASS', 'FAIL', 'OOT' (Out of Tolerance)

  // The Hybrid Router
  sourceSystem String // 'INTERNAL' or 'AUTOMATED'

  // If INTERNAL - link to our CalibrationEvent
  internalEventId String?
  internalEvent   CalibrationEvent? @relation(fields: [internalEventId], references: [id])

  // If AUTOMATED - external certificate reference
  externalCertRef String? // Beamex Certificate ID
  externalPdfLink String? // Link to Beamex-generated PDF

  // Common fields
  performedBy String?
  maxError    Float?

  createdAt DateTime @default(now())

  @@index([instrumentTagId, calDate])
  @@index([sourceSystem])
}

// ============================================================================
// SKID CONFIGURATION (Multi-Driver Support)
// ============================================================================
// Supports: 2 engines (A/B) driving 1 compressor, or 1 engine driving 2 compressors
// This is a many-to-many relationship between driver FLs and driven FLs

model SkidConfiguration {
  id String @id @default(uuid())

  // The parent skid (FL with type SKID)
  skidFlId String
  skidFl   FunctionalLocation @relation("SkidConfig", fields: [skidFlId], references: [id])

  name     String // "K-101 Compressor Train A"
  isActive Boolean @default(true)

  // Drive Train Links (many-to-many through SkidDriveTrain)
  driveTrains SkidDriveTrain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skidFlId])
}

model SkidDriveTrain {
  id String @id @default(uuid())

  skidConfigId String
  skidConfig   SkidConfiguration @relation(fields: [skidConfigId], references: [id], onDelete: Cascade)

  // Driver (Prime Mover) - can be ENGINE, MOTOR, TURBINE
  driverFlId String
  driverFl   FunctionalLocation @relation("DriveTrainDriver", fields: [driverFlId], references: [id])

  // Driven (Load) - can be COMPRESSOR, GENERATOR, PUMP
  drivenFlId String
  drivenFl   FunctionalLocation @relation("DriveTrainDriven", fields: [drivenFlId], references: [id])

  // Drive ratio / coupling info
  couplingType String? // 'DIRECT', 'GEARBOX', 'BELT', 'CLUTCH'
  gearRatio    Float? // e.g., 1.5:1
  designation  String? // 'PRIMARY', 'STANDBY', 'TRAIN_A', 'TRAIN_B'

  createdAt DateTime @default(now())

  @@index([driverFlId])
  @@index([drivenFlId])
}

// ============================================================================
// ENGINE SPECIFICATIONS (Prime Mover Type)
// ============================================================================

model EngineRegistry {
  id          String @id @default(uuid())
  tagId       String @unique
  description String

  // Engine Classification
  engineType String // 'RECIPROCATING', 'GAS_TURBINE', 'STEAM_TURBINE'
