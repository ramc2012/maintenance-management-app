  designation  String?
  department   String?

  role         String // SUPERVISOR, TECHNICIAN, HELPER, CONTRACTOR, SAFETY_OFFICER
  isContractor Boolean @default(false)
  companyName  String?

  startTime   DateTime?
  endTime     DateTime?
  hoursWorked Float?

  remarks String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// WORK ORDER CHECKLIST (Tasks within Work Orders)
// ============================================================================

model WorkOrderChecklist {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  sequence    Int     @default(0)
  taskCode    String?
  description String

  isCompleted Boolean   @default(false)
  completedBy String?
  completedAt DateTime?

  remarks String?

  createdAt DateTime @default(now())
}

// ============================================================================
// CONTRACTS MODULE
// ============================================================================

model Contract {
  id             String  @id @default(uuid())
  contractNumber String  @unique
  workspaceSlug  String? @unique
  workspaceLabel String?

  title    String
  scope    String
  workType String // OPERATION, MAINTENANCE, CONSTRUCTION, INSPECTION, SUPPLY, CONSULTANCY

  contractorName String
  contractorCode String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?

  contractValue Float
  currency      String  @default("INR")
  paymentTerms  String?

  startDate DateTime
  endDate   DateTime

  status                  String  @default("ACTIVE") // DRAFT, ACTIVE, COMPLETED, TERMINATED, EXPIRED, ON_HOLD
  externalAccessEnabled   Boolean @default(false)
  shareAllInstallations   Boolean @default(false)
  shareAllInstrumentTypes Boolean @default(false)
  shareAllEquipmentScopes Boolean @default(false)
  dashboardMode           String  @default("CONTRACT") // CONTRACT, INSTALLATION, SERVICE

  installationId String?
  departmentId   String?

  documentRef String?

  ongcOfficer  String?
  approvedBy   String?
  approvalDate DateTime?

  remarks   String?
  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccesses             ContractUserAccess[]
  installationScopes       ContractInstallationScope[]
  instrumentTypeScopes     ContractInstrumentTypeScope[]
  equipmentScopes          ContractEquipmentScope[]
  functionalLocationScopes ContractFunctionalLocationScope[]
  maintenanceRequests      MaintenanceRequest[]
  workOrders               WorkOrder[]
  milestones               ContractMilestone[]
  documents                ContractDocument[]
  reports                  ContractorReport[]
  executionLogs            WorkOrderExecutionLog[]           @relation("ContractExecutionLogs")
}

model ContractUserAccess {
  id                    String    @id @default(uuid())
  contractId            String
  contract              Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessRole            String // ONGC_CONTRACT_OWNER, ONGC_REVIEWER, CONTRACTOR_ADMIN, CONTRACTOR_COORDINATOR, CONTRACTOR_TECHNICIAN, VIEW_ONLY
  scopeMode             String    @default("CONTRACT") // CONTRACT, INSTALLATION, ASSET, HYBRID
  canViewDashboard      Boolean   @default(true)
  canCreateRequests     Boolean   @default(false)
  canGenerateWorkOrders Boolean   @default(false)
  canSubmitReports      Boolean   @default(false)
  canReviewReports      Boolean   @default(false)
  canCloseWorkOrders    Boolean   @default(false)
  canManageUsers        Boolean   @default(false)
  isActive              Boolean   @default(true)
  invitedBy             String?
  activatedAt           DateTime?
  lastAccessAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([contractId, userId])
  @@index([userId, isActive])
  @@index([contractId, accessRole, isActive])
}

model ContractInstallationScope {
  id                    String       @id @default(uuid())
  contractId            String
  contract              Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installationId        String
  installation          Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  accessLevel           String       @default("EXECUTE") // VIEW, UPDATE, EXECUTE
  canRaiseRequests      Boolean      @default(true)
  canGenerateWorkOrders Boolean      @default(false)
  canSubmitReports      Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([contractId, installationId])
  @@index([installationId, accessLevel])
}

model ContractInstrumentTypeScope {
  id                String   @id @default(uuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  instrumentType    String
  serviceLine       String?
  accessLevel       String   @default("UPDATE") // VIEW, UPDATE, EXECUTE
  canEditMasterData Boolean  @default(false)
  canSubmitReports  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([contractId, instrumentType])
  @@index([serviceLine])
}

model ContractEquipmentScope {
  id                String   @id @default(uuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  scopeType         String // CATEGORY, TYPE, TAG, SERVICE_LINE
  scopeValue        String
  accessLevel       String   @default("EXECUTE") // VIEW, UPDATE, EXECUTE
  canEditMasterData Boolean  @default(false)
  canSubmitReports  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([contractId, scopeType, scopeValue])
  @@index([scopeType, scopeValue])
}

model ContractFunctionalLocationScope {
  id          String             @id @default(uuid())
  contractId  String
  contract    Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  flId        String
  fl          FunctionalLocation @relation(fields: [flId], references: [id], onDelete: Cascade)
  accessLevel String             @default("EXECUTE") // VIEW, UPDATE, EXECUTE
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([contractId, flId])
  @@index([flId, accessLevel])
}

model ContractMilestone {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  title       String
  description String?

  dueDate DateTime

  paymentPct Float?
  paymentAmt Float?

  status      String    @default("PENDING") // PENDING, COMPLETED, DELAYED, WAIVED
  completedAt DateTime?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractDocument {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  title        String
  docType      String // CONTRACT, AMENDMENT, INVOICE, BOQ, DRAWING, SAFETY
  originalName String
  storedName   String
  filePath     String
  fileSize     Int
  mimeType     String?

  uploadedBy String
  uploadedAt DateTime @default(now())
}

model WorkOrderExecutionLog {
  id              String    @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract? @relation("ContractExecutionLogs", fields: [contractId], references: [id], onDelete: SetNull)
  stage           String
  previousStage   String?
  remarks         String?
  performedById   String?
  performedBy     User?     @relation("WorkOrderExecutionPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  performedByName String?
  performedByRole String?
  sourceApp       String    @default("CONTRACTOR_APP")
  createdAt       DateTime  @default(now())

  @@index([workOrderId, createdAt])
  @@index([contractId, createdAt])
}

model ContractorReport {
  id                   String                  @id @default(uuid())
  contractId           String
  contract             Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workOrderId          String?
  workOrder            WorkOrder?              @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest?     @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  installationId       String?
  installation         Installation?           @relation(fields: [installationId], references: [id], onDelete: SetNull)
  assetClass           String
  assetTag             String
  instrumentTagId      String?
  instrument           InstrumentMaster?       @relation(fields: [instrumentTagId], references: [tagId], onDelete: SetNull)
  runningEquipmentTag  String?
  runningEquipment     RunningEquipmentMaster? @relation(fields: [runningEquipmentTag], references: [equipmentTag], onDelete: SetNull)
  reportType           String // INSPECTION, CALIBRATION, CONDITION, BREAKDOWN, COMPLETION, EVIDENCE
  reportStatus         String                  @default("DRAFT") // DRAFT, SUBMITTED, PENDING_REVIEW, APPROVED, REJECTED, REVISION_REQUIRED
  severity             String?
  title                String
  summary              String?
  findings             Json?
  measurements         Json?
  recommendations      String?
  actionTaken          String?
  evidence             Json?
  submittedById        String?
  submittedBy          User?                   @relation("ContractReportsSubmitted", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById         String?
  reviewedBy           User?                   @relation("ContractReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt          DateTime?
  reviewedAt           DateTime?
  revisionNotes        String?
  sourceApp            String                  @default("CONTRACTOR_APP")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([contractId, reportStatus, createdAt])
  @@index([workOrderId, reportStatus])
  @@index([installationId, assetClass, createdAt])
  @@index([assetTag, reportType, createdAt])
}

// ============================================================================
// PRESENTATIONS MODULE
// ============================================================================

model Presentation {
  id String @id @default(uuid())

  title       String
  category    String // SAFETY, TECHNICAL, MANAGEMENT, TRAINING, POLICY, OTHER
  description String?

  originalName String
  storedName   String
  filePath     String
  fileSize     Int
  mimeType     String?

  author  String?
  version String?
  tags    String[]

  installationId String?
  departmentId   String?

  isPublic Boolean @default(true)

  uploadedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// NOTIFICATION MODEL (for PM due, calibration due, overdue WOs)
// ============================================================================

model Notification {
  id           String    @id @default(cuid())
  userId       String?
  username     String?
  role         String?
  module       String
  type         String
  title        String
  message      String
  severity     String    @default("INFO") // HIGH, MEDIUM, INFO
  entityType   String?
  entityId     String?
  status       String    @default("UNREAD") // UNREAD, READ
  dedupeKey    String    @unique
  metadata     Json?
  scheduledFor DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, status, createdAt])
  @@index([module, type, createdAt])
}

// ============================================================================
// WORK ORDER ATTACHMENTS (Photos & Documents on Work Orders)
// ============================================================================

model WOAttachment {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String // relative path under storage/wo-attachments/
  fileType    String // PHOTO, DOCUMENT
  mimeType    String?
  fileSize    Int?
  caption     String?
  uploadedBy  String
  uploadedAt  DateTime  @default(now())

  @@index([workOrderId])
}

// ============================================================================
// INSPECTION ROUNDS (Shift walkdown / patrol routes)
// ============================================================================

model InspectionRound {
  id           String                @id @default(uuid())
  name         String
  description  String?
  flIds        Json // ordered array: [{flId, flName, description}]
  frequency    String // DAILY, WEEKLY, MONTHLY, SHIFT
  assignedDept String?
  isActive     Boolean               @default(true)
  executions   InspectionExecution[]
  createdBy    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model InspectionExecution {
  id           String          @id @default(uuid())
  roundId      String
  round        InspectionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  executedBy   String
  executedAt   DateTime        @default(now())
  completedAt  DateTime?
  status       String          @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  readings     Json // [{flId, flName, value, unit, status: OK|WARNING|CRITICAL, notes, photoUrl}]
  flaggedItems Json? // [{flId, flName, note, severity}]
  createdAt    DateTime        @default(now())

  @@index([roundId, executedAt])
}

// ============================================================================
// LABOR RATE (for indirect maintenance cost calculation)
// ============================================================================

model LaborRate {
  id            String   @id @default(uuid())
  department    String
  designation   String?
  dailyRate     Float // Rate per day (8hrs)
  currency      String   @default("INR")
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([department, designation, effectiveFrom])
}

// ============================================================================
// AUDIT OBSERVATIONS, ACTIONS, AND ACTIVITY LOGS
// ============================================================================

model AuditObservation {
  id             String        @id @default(uuid())
  observationNo  String        @unique
  agency         String
  auditDate      DateTime
  installationId String?
  department     String?
  service        String?
  category       String?
  severity       String
  observation    String
  reference      String?
  targetDate     DateTime?
  reportedBy     String?
  assignedTo     String?
  remarks        String?
  status         String        @default("OPEN")
  closedDate     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  actions        AuditAction[]

  @@index([status, createdAt])
  @@index([installationId, status])
  @@index([agency, status])
}

model AuditAction {
  id            String           @id @default(uuid())
  observationId String
  observation   AuditObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  actionNo      Int
  description   String
  assignedTo    String?
  targetDate    DateTime
  status        String           @default("PENDING")
  completedDate DateTime?
  remarks       String?
  verifiedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([observationId, actionNo])
  @@index([status, targetDate])
}

model ActivityAuditLog {
  id         String   @id @default(uuid())
  requestId  String?
  userId     String?
  username   String?
  role       String?
  module     String
  action     String
  method     String
  path       String
  entityType String?
  entityId   String?
  statusCode Int
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
}

// ============================================================================
// MANUAL REPOSITORY
// ============================================================================

model ManualFolder {
  id        String               @id @default(uuid())
  name      String
  category  String
  primaryDiscipline Discipline   @default(MECHANICAL)
  parentId  String?
  parent    ManualFolder?        @relation("ManualFolderTree", fields: [parentId], references: [id])
  children  ManualFolder[]       @relation("ManualFolderTree")
  documents RepositoryDocument[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([category])
  @@index([primaryDiscipline])
}

model RepositoryDocument {
  id             String       @id @default(uuid())
  folderId       String
  folder         ManualFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  primaryDiscipline Discipline @default(MECHANICAL)
  originalName   String
  storedName     String
  mimeType       String
  extension      String?
  size           Int
  repositoryPath String
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime     @default(now())

  @@index([primaryDiscipline, uploadedAt])
}

// ============================================================================
// PROCESS LOGS
// ============================================================================

model GasCompressionLog {
  id                String   @id @default(uuid())
  date              DateTime
  shift             String   @default("GENERAL")
  sourceMode        String   @default("MANUAL") // MANUAL, AUTO, HYBRID
  compressorId      String
  installationId    String?
  primaryDiscipline Discipline @default(MECHANICAL)
  operationalLogId  String?  @unique
  inputGasVolume    Float?
  outputGasVolume   Float?
  fuelGasVolume     Float?
  recycleGasVolume  Float?
  flareGasVolume    Float?
  gasCompressed     Float    @default(0)
  runHours          Float    @default(0)
  flowRate          Float    @default(0)
  suctionPressure   Float?
  dischargePressure Float?
  interstagePressure Float?
  suctionTemp       Float?
  dischargeTemp     Float?
  lubeOilPressure   Float?
  lubeOilTemp       Float?
  jacketWaterTemp   Float?
  vibration         Float?
  loadPct           Float?
  efficiencyPct     Float?
  tripCount         Int      @default(0)
  shutdownReason    String?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  operationalLog OperationalLog? @relation(fields: [operationalLogId], references: [id], onDelete: SetNull)

  @@unique([date, shift, compressorId])
  @@index([installationId, date])
  @@index([compressorId, date])
}
