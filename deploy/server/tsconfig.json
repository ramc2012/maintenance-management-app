{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "exclude": [
    "prisma",
    "tests",
    "vitest.config.ts",
    "node_modules",
    "scripts",
    "src/scripts",
    "src/validation",
    "src/middleware/errorHandler.ts",
    "src/routes/fmsSync.routes.ts"
  ]
}
