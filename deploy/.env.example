POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maintenance_db
DATABASE_URL=postgresql://user:change-me@localhost:5433/maintenance_db
JWT_SECRET=change-me-to-a-long-random-secret
WEBUI_SECRET_KEY=change-me
# Host-facing ports for local Docker
POSTGRES_PORT=5433
REDIS_PORT=6380
SERVER_PORT=5000
CLIENT_PORT=8080
MOBILE_PORT=8084
COGNITIVE_PORT=8001
OLLAMA_PORT=11434
OLLAMA_WEBUI_PORT=3001

# For local non-Docker cognitive runs
OLLAMA_URL=http://host.docker.internal:11434

# For Docker Compose service-to-service traffic
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_OLLAMA_MODEL=gemma4:e4b
DOCKER_CLIENT_API_BASE_URL=/api
DOCKER_CLIENT_COGNITIVE_API_BASE_URL=/cognitive
DOCKER_MOBILE_API_URL=/api
DOCKER_MOBILE_COGNITIVE_API_URL=/cognitive

PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5000,http://localhost:3000
SEED_ADMIN_ON_STARTUP=false
SEED_ADMIN_PASSWORD=change-me-admin-password
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
